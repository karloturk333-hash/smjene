# SQLite baza (datoteka u prisma/). Kopiraj u .env: cp .env.example .env
DATABASE_URL="file:./dev.db"
PORT=4000

# Tajni "pepper" (HMAC ključ) za hashiranje session tokena. NIJE u bazi.
# Generiraj svoj i drži ga tajnim: openssl rand -hex 32
# .env je u .gitignore — NIKAD ne commitaj pravu vrijednost.
AUTH_PEPPER="promijeni-me-na-rezultat-openssl-rand-hex-32"
