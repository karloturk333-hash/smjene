generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Korisnik aplikacije (konobar). Svaka smjena pripada točno jednom korisniku.
model User {
  id           String    @id @default(cuid())
  /// E-mail za prijavu — jedinstven.
  email        String    @unique
  /// bcrypt hash lozinke. NIKAD ne čuvamo samu lozinku.
  passwordHash String
  createdAt    DateTime  @default(now())

  shifts   Shift[]
  sessions Session[]
}

/// Aktivna prijava (server-side sesija). U bazi čuvamo HASH tokena, ne sam token.
model Session {
  id        String   @id @default(cuid())
  /// SHA-256 hash random tokena koji živi u httpOnly kolačiću. Jedinstven.
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Trenutak isteka sesije.
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

/// Jedna odrađena smjena konobara s pripadajućim napojnicama.
model Shift {
  id        String   @id @default(cuid())
  /// Datum smjene (početak dana).
  date      DateTime
  /// Početak smjene "HH:MM".
  startTime String
  /// Kraj smjene "HH:MM".
  endTime   String
  /// Trajanje u satima (izračunato na serveru; podržava prekonoćne smjene).
  hours     Float
  /// Napojnice u gotovini (EUR).
  tipsCash  Float    @default(0)
  /// Napojnice karticom (EUR).
  tipsCard  Float    @default(0)
  /// Lokal / restoran (opcionalno).
  venue     String?
  /// Bilješka (opcionalno).
  note      String?
  /// Broj gostiju posluženih u smjeni.
  guests    Int      @default(0)
  /// Vlasnik smjene — svaka smjena pripada točno jednom korisniku.
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}
